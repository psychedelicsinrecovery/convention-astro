---
import Base from "../layouts/Base.astro";
import { convention, days, highlights, links } from "../data/convention";

const wayCards = [links.landing, links.schedule, links.liveStream, links.pixieset, links.committee, links.astrolog];
---

<Base
  title={`${convention.title} · PIR®`}
  description={`${convention.title} — ${convention.dates}, ${convention.venue}. The story, the schedule, the gallery, and what comes next.`}
  active="overview"
>
  <div class="pir-conv">
    <section class="hero">
      <div class="wrap">
        <span class="kicker"><i class="ph-fill ph-confetti"></i> The gatherings of PIR® · Denver 2026</span>
        <h1>The Inaugural PIR® Convention</h1>
        <p class="lede">
          {convention.anniversary} {convention.tagline} This site is the home of PIR®'s
          conventions on the fellowship's own ground: each gathering's story, its galleries,
          and what comes next — Denver 2026 highlighted below, and the next one already
          stirring.
        </p>
        <div class="hero-facts">
          <span class="fact"><i class="ph-fill ph-calendar-blank"></i> {convention.dates}</span>
          <span class="fact"><i class="ph-fill ph-map-pin"></i> {convention.venue}</span>
          <span class="fact"><i class="ph-fill ph-users-three"></i> In person & on stream</span>
        </div>
        <div class="hero-cta">
          <a class="btn gallery-cta" href="gallery"><i class="ph-fill ph-images"></i> The Convention Galleries <i class="ph-fill ph-arrow-right"></i></a>
          <a class="btn primary" href={links.schedule.href}><i class="ph-fill ph-list-checks"></i> See the schedule</a>
          <a class="btn" href={links.liveStream.href} target="_blank" rel="noopener"><i class="ph-fill ph-video-camera"></i> Watch the sessions</a>
        </div>
      </div>
    </section>

    <section class="band">
      <div class="wrap">
        <div class="band-head"><h2>What happened</h2><span class="rule"></span><a href={links.landing.href} target="_blank" rel="noopener">Convention page ↗</a></div>
        <div class="bento">
          {highlights.map((h) => (
            <article class="hl">
              <i class={`ph-fill ph-${h.icon}`}></i>
              <h3>{h.title}</h3>
              <p>{h.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="band">
      <div class="wrap">
        <div class="band-head"><h2>The four days</h2><span class="rule"></span><a href={links.schedule.href} target="_blank" rel="noopener">Full schedule ↗</a></div>
        <div class="days">
          {days.map((d) => (
            <article class="day">
              <span class="d-date">{d.day} · {d.date}</span>
              <h3>{d.day}</h3>
              <span class="d-label">{d.label}</span>
              <p>{d.summary}</p>
              <a class="pdf" href={d.pdf.href} target="_blank" rel="noopener"><i class="ph-fill ph-file-pdf"></i> {d.pdf.label}</a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="band">
      <div class="wrap">
        <div class="band-head"><h2>All the ways around</h2><span class="rule"></span><a href="events">Past & upcoming</a></div>
        <div class="ways">
          {wayCards.map((w) => (
            <a class="way" href={w.href} target="_blank" rel="noopener">
              <i class={w.label.includes("Gallery") ? "ph-fill ph-image" : w.label.includes("Stream") ? "ph-fill ph-video-camera" : w.label.includes("Schedule") ? "ph-fill ph-list-checks" : w.label.includes("Committee") ? "ph-fill ph-hand-heart" : w.label.includes("AstroLog") ? "ph-fill ph-clock-counter-clockwise" : "ph-fill ph-globe"}></i>
              <span class="w-label">{w.label}</span>
              <span class="w-note">{w.note}</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  </div>
</Base>

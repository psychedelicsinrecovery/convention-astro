---
import Base from "../layouts/Base.astro";
import { convention, links } from "../data/convention";
const galleryApp = "https://psychedelicsinrecovery.github.io/gallery/";
---

<Base
  title={`Convention Gallery · ${convention.title} · PIR®`}
  description="The fellowship's shared photo album from the Inaugural PIR® Convention — Denver, October 2026. Browse, remember, and add your own photos."
  active="gallery"
>
  <div class="pir-conv">
    <section class="hero compact">
      <div class="wrap">
        <span class="kicker"><i class="ph-fill ph-image"></i> Shared with consent</span>
        <h1>The Convention Gallery</h1>
        <p class="lede">
          The fellowship's photos from Denver — browsable, downloadable, and cared for. A
          temporary Pixieset album is live below while the fellowship's own gallery fills in.
        </p>
      </div>
    </section>

    <!-- The marquee: what the albums will hold, looping gently. -->
    <div class="conv-marquee" aria-label="A scrolling preview of the moments the albums will hold">
      <div class="conv-marquee-label">In the albums, moments like these</div>
      <p class="conv-marquee-note">Illustrated previews — as albums come in, real photos take their places here.</p>
      <div class="conv-track">
        {[
          ["The opening ceremony", "tile-1"],
          ["Panels & speakers", "tile-2"],
          ["The first hug in person", "tile-3"],
          ["Candlelight meetings", "tile-4"],
          ["Art & creativity", "tile-5"],
          ["Fellowship dinners", "tile-6"],
        ].map(([cap, tile]) => (
          <figure class="conv-tile">
            <img src={`https://psychedelicsinrecovery.github.io/gallery/assets/placeholders/${tile}.svg`} alt="" loading="lazy" />
            <figcaption>{cap}</figcaption>
          </figure>
        ))}
        {[
          ["The opening ceremony", "tile-1"],
          ["Panels & speakers", "tile-2"],
          ["The first hug in person", "tile-3"],
          ["Candlelight meetings", "tile-4"],
          ["Art & creativity", "tile-5"],
          ["Fellowship dinners", "tile-6"],
        ].map(([cap, tile]) => (
          <figure class="conv-tile">
            <img src={`https://psychedelicsinrecovery.github.io/gallery/assets/placeholders/${tile}.svg`} alt="" loading="lazy" />
            <figcaption>{cap}</figcaption>
          </figure>
        ))}
      </div>
    </div>

    <section class="band">
      <div class="wrap">
        <div class="gallery-hero">
          <a class="gallery-frame" href={links.pixieset.href} target="_blank" rel="noopener" style="min-height:280px;display:block;text-decoration:none">
            <img src="/convention-astro/gallery-preview.jpg" alt="Cover of the Inaugural PIR® Convention photo album" loading="lazy" onerror="this.onerror=null;this.src='/convention-astro/favicon.svg';this.style.objectFit='contain';this.style.background='radial-gradient(60% 60% at 70% 100%, rgba(167,139,250,.18), transparent 70%)'" />
          </a>
          <div class="gallery-side">
            <a class="btn primary" href={links.pixieset.href} target="_blank" rel="noopener"><i class="ph-fill ph-image"></i> Open the Pixieset album</a>
            <a class="btn" href={galleryApp + "walkthrough.html"}><i class="ph-fill ph-map-trifold"></i> Add your photos — the walkthrough</a>
            <a class="btn" href="https://drive.google.com/drive/folders/1zUL1fHkDIWJLKrtHzfFToceFoFl-PiTu?usp=sharing" target="_blank" rel="noopener"><i class="ph-fill ph-upload-simple"></i> Upload to the Drive folder</a>
            <a class="btn" href={galleryApp}><i class="ph-fill ph-images"></i> The fellowship's gallery</a>
            <p class="consent">{convention.photosNote}</p>
          </div>
        </div>
      </div>
    </section>

    <section class="band">
      <div class="wrap">
        <div class="band-head"><h2>How the galleries came to be</h2><span class="rule"></span><a href={galleryApp} target="_blank" rel="noopener">The fellowship's gallery ↗</a></div>
        <div class="bento">
          <article class="hl">
            <i class="ph-fill ph-chat-circle-dots"></i>
            <h3>A WhatsApp request went rogue</h3>
            <p>It began as a simple favor: put Anne R.'s Pixieset album on gallery.psychedelicsinrecovery.org — without sharing a single password. One thread later, the whole thing had grown legs.</p>
          </article>
          <article class="hl">
            <i class="ph-fill ph-google-photos-logo"></i>
            <h3>A Drive folder gathered the photos</h3>
            <p>A shared Google Drive folder became the gathering basket: photos from every corner of the Convention, dropped in by members who were there.</p>
          </article>
          <article class="hl">
            <i class="ph-fill ph-images"></i>
            <h3>The fellowship built a gallery of its own</h3>
            <p>And then a decision: the photos of our recovery deserve a home we own. The PIR® Gallery lives on GitHub — every album the fellowship makes, kept on its own ground.</p>
          </article>
        </div>
        <p class="lede" style="margin-top:1rem">
          The Convention album is the gallery's first — its featured album — and this site is its
          Astro home. Explore the whole collection, and the walkthrough for adding your own photos,
          at <a href={galleryApp} style="color:inherit">psychedelicsinrecovery.github.io/gallery</a>.
        </p>
      </div>
    </section>
  </div>

  <script is:inline>
    // Every marquee is draggable and wheel-scrollable; the loop pauses while you hold it.
    function marqueeJS(track) {
      if (!track) return;
      var x = 0, half = 0, drag = false, sx = 0, x0 = 0, hover = false;
      var reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
      var measure = function () { half = track.scrollWidth / 2 || track.scrollWidth || 1; };
      measure(); addEventListener("resize", measure);
      track.style.animation = "none";
      track.style.cursor = "grab";
      track.style.touchAction = "pan-y";
      var frame = function () {
        if (!drag && !hover && !reduce) x += 0.4;
        var m = ((x % half) + half) % half;
        track.style.transform = "translateX(" + (-m) + "px)";
        requestAnimationFrame(frame);
      };
      track.addEventListener("pointerdown", function (e) { drag = true; sx = e.clientX; x0 = x; track.style.cursor = "grabbing"; track.setPointerCapture(e.pointerId); });
      track.addEventListener("pointermove", function (e) { if (drag) x = x0 - (e.clientX - sx); });
      ["pointerup", "pointercancel"].forEach(function (t) { track.addEventListener(t, function () { drag = false; track.style.cursor = "grab"; }); });
      track.addEventListener("mouseenter", function () { hover = true; });
      track.addEventListener("mouseleave", function () { hover = false; });
      track.addEventListener("wheel", function (e) { x += e.deltaY; e.preventDefault(); }, { passive: false });
      frame();
    }
    document.querySelectorAll(".conv-track").forEach(marqueeJS);
  </script>
</Base>
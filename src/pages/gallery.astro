---
import Base from "../layouts/Base.astro";
import { convention, links } from "../data/convention";
const galleryApp = "https://psychedelicsinrecovery.github.io/gallery/";
const driveHref = "https://drive.google.com/drive/folders/1zUL1fHkDIWJLKrtHzfFToceFoFl-PiTu?usp=sharing";
const tiles = [
  ["The opening ceremony", "tile-1"],
  ["Panels & speakers", "tile-2"],
  ["The first hug in person", "tile-3"],
  ["Candlelight meetings", "tile-4"],
  ["Art & creativity", "tile-5"],
  ["Fellowship dinners", "tile-6"],
];
---

<Base
  title={`Convention Gallery · ${convention.title} · PIR®`}
  description="The fellowship's shared photo album from the Inaugural PIR® Convention — Denver, October 2026. Browse, remember, and add your own photos."
  active="gallery"
>
  <div class="pir-conv">
    <section class="hero compact hero-gallery">
      <div class="wrap">
        <span class="kicker"><i class="ph-fill ph-image"></i> Shared with consent</span>
        <h1>The Convention Gallery</h1>
        <p class="lede">
          The fellowship's photos from Denver — browsable, downloadable, and cared for. Pick an
          album below to open it in the lightbox, or wander the moments in the marquee.
        </p>
      </div>

      <!-- The marquee lives in the hero now: the moments, right under the welcome. -->
      <div class="conv-marquee" aria-label="A scrolling preview of the moments the albums will hold">
        <div class="conv-marquee-label">In the albums, moments like these</div>
        <div class="conv-track">
          {tiles.map(([cap, tile]) => (
            <figure class="conv-tile" data-tile={tile} data-cap={cap} role="button" tabindex="0" aria-label={`Preview: ${cap}`}>
              <img src={`https://psychedelicsinrecovery.github.io/gallery/assets/placeholders/${tile}.svg`} alt="" loading="lazy" />
              <figcaption>{cap}</figcaption>
            </figure>
          ))}
          {tiles.map(([cap, tile]) => (
            <figure class="conv-tile" data-tile={tile} data-cap={cap} role="button" tabindex="0" aria-label={`Preview: ${cap}`}>
              <img src={`https://psychedelicsinrecovery.github.io/gallery/assets/placeholders/${tile}.svg`} alt="" loading="lazy" />
              <figcaption>{cap}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <section class="band" id="albums">
      <div class="wrap">
        <div class="band-head"><h2>Choose an album</h2><span class="rule"></span><a href={galleryApp}>The full gallery ↗</a></div>
        <p class="lede" style="font-size:0.9rem">
          Select an album to open it in the lightbox — arrows to wander, a caption on every photo.
          Albums still gathering point the way to where their photos live right now.
        </p>
        <div class="album-grid" id="album-grid" aria-live="polite"></div>
      </div>
    </section>

    <section class="band">
      <div class="wrap">
        <div class="gallery-hero">
          <a class="gallery-frame" href={links.pixieset.href} target="_blank" rel="noopener" style="min-height:280px;display:block;text-decoration:none">
            <img src="/convention-astro/gallery-preview.jpg" alt="Cover of the Inaugural PIR® Convention photo album" loading="lazy" onerror="this.onerror=null;this.src='/convention-astro/favicon.svg';this.style.objectFit='contain';this.style.background='radial-gradient(60% 60% at 70% 100%, rgba(167,139,250,.18), transparent 70%)'" />
          </a>
          <div class="gallery-side">
            <a class="btn primary" href={links.pixieset.href} target="_blank" rel="noopener"><i class="ph-fill ph-image"></i> Open the Pixieset album</a>
            <a class="btn" href={galleryApp + "walkthrough.html"}><i class="ph-fill ph-map-trifold"></i> Add your photos — the walkthrough</a>
            <a class="btn" href={driveHref} target="_blank" rel="noopener"><i class="ph-fill ph-upload-simple"></i> Upload to the Drive folder</a>
            <a class="btn" href={galleryApp}><i class="ph-fill ph-images"></i> The fellowship's gallery</a>
            <p class="consent">{convention.photosNote}</p>
          </div>
        </div>
      </div>
    </section>

    <section class="band">
      <div class="wrap">
        <div class="band-head"><h2>How the galleries came to be</h2><span class="rule"></span><a href={galleryApp} target="_blank" rel="noopener">The fellowship's gallery ↗</a></div>
        <div class="bento">
          <article class="hl">
            <i class="ph-fill ph-chat-circle-dots"></i>
            <h3>A WhatsApp request went rogue</h3>
            <p>It began as a simple favor: put Anne R.'s Pixieset album on gallery.psychedelicsinrecovery.org — without sharing a single password. One thread later, the whole thing had grown legs.</p>
          </article>
          <article class="hl">
            <i class="ph-fill ph-google-photos-logo"></i>
            <h3>A Drive folder gathered the photos</h3>
            <p>A shared Google Drive folder became the gathering basket: photos from every corner of the Convention, dropped in by members who were there.</p>
          </article>
          <article class="hl">
            <i class="ph-fill ph-images"></i>
            <h3>The fellowship built a gallery of its own</h3>
            <p>And then a decision: the photos of our recovery deserve a home we own. The PIR® Gallery lives on GitHub — every album the fellowship makes, kept on its own ground.</p>
          </article>
        </div>
      </div>
    </section>
  </div>

  <!-- The lightbox: click a tile or an album, wander with the arrows. -->
  <div class="conv-lb" id="lb" role="dialog" aria-modal="true" aria-label="Photo viewer">
    <div class="lb-top">
      <span class="count"><b id="lb-i">1</b> / <span id="lb-n">1</span></span>
      <span class="spacer"></span>
      <a class="dl" id="lb-dl" href="#" download target="_blank" rel="noopener"><i class="ph-fill ph-download-simple"></i> Download</a>
      <button class="x" id="lb-x" aria-label="Close"><i class="ph-fill ph-x"></i> Close</button>
    </div>
    <div class="stage">
      <button class="arrow prev" id="lb-prev" aria-label="Previous photo"><i class="ph-fill ph-caret-left"></i></button>
      <img id="lb-img" alt="" />
      <button class="arrow next" id="lb-next" aria-label="Next photo"><i class="ph-fill ph-caret-right"></i></button>
    </div>
    <div class="lb-cap" id="lb-cap"></div>
  </div>

  <script is:inline>
    // Every marquee is draggable, wheel-scrubbable, and carries its own controls:
    // arrows to page through, page dots to jump, and a counter that always knows where you are.
    function marqueeJS(track) {
      if (!track) return;
      var box = track.parentElement;
      if (box.querySelector(".mar-controls")) return;
      var x = 0, xt = 0, half = 1, page = 1, pages = 1, drag = false, sx = 0, x0 = 0, hover = false, cur = -1;
      var reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
      var ctl = document.createElement("div");
      ctl.className = "mar-controls";
      ctl.innerHTML = '<button type="button" class="mar-btn mar-prev" aria-label="Previous page"><i class="ph-fill ph-caret-left"></i></button>' +
        '<div class="mar-dots"></div><span class="mar-count">1 / 1</span>' +
        '<button type="button" class="mar-btn mar-next" aria-label="Next page"><i class="ph-fill ph-caret-right"></i></button>';
      box.appendChild(ctl);
      var dotsEl = ctl.querySelector(".mar-dots"), countEl = ctl.querySelector(".mar-count");
      var dots = [];
      var clamp = function (v) { return Math.max(0, Math.min(half - page, v)); };
      var measure = function () {
        half = track.scrollWidth / 2 || track.scrollWidth || 1;
        page = box.clientWidth || 1;
        pages = Math.max(1, Math.round(half / page));
        if (dots.length !== pages) {
          dotsEl.innerHTML = ""; dots = [];
          for (var i = 0; i < pages; i++) {
            (function (i) {
              var d = document.createElement("button");
              d.type = "button"; d.className = "mar-dot"; d.setAttribute("aria-label", "Page " + (i + 1));
              d.addEventListener("click", function () { xt = clamp(i * page); });
              dotsEl.appendChild(d); dots.push(d);
            })(i);
          }
        }
      };
      measure(); addEventListener("resize", measure);
      ctl.querySelector(".mar-prev").addEventListener("click", function () { xt = clamp(xt - page); });
      ctl.querySelector(".mar-next").addEventListener("click", function () { xt = clamp(xt + page); });
      track.style.animation = "none";
      track.style.cursor = "grab";
      track.style.touchAction = "pan-y";
      var frame = function () {
        if (!drag && !hover && !reduce) xt += 0.4;
        x += (xt - x) * 0.14;
        var m = ((x % half) + half) % half;
        track.style.transform = "translateX(" + (-m) + "px)";
        var p = Math.min(pages - 1, Math.floor(m / page));
        if (p !== cur) {
          cur = p;
          countEl.textContent = (p + 1) + " / " + pages;
          dots.forEach(function (d, i) { if (i === p) d.setAttribute("aria-current", "true"); else d.removeAttribute("aria-current"); });
        }
        requestAnimationFrame(frame);
      };
      track.addEventListener("pointerdown", function (e) { drag = true; sx = e.clientX; x0 = x; xt = x; track.style.cursor = "grabbing"; track.setPointerCapture(e.pointerId); });
      track.addEventListener("pointermove", function (e) { if (drag) xt = clamp(x0 - (e.clientX - sx)); });
      ["pointerup", "pointercancel"].forEach(function (t) { track.addEventListener(t, function () { drag = false; track.style.cursor = "grab"; }); });
      track.addEventListener("mouseenter", function () { hover = true; });
      track.addEventListener("mouseleave", function () { hover = false; });
      track.addEventListener("wheel", function (e) { xt = clamp(xt + e.deltaY); e.preventDefault(); }, { passive: false });
      frame();
    }
    document.querySelectorAll(".conv-track").forEach(marqueeJS);

    // ---- The lightbox ----
    var PHOTOS = [], CUR = 0;
    var lb = document.getElementById("lb"), lbImg = document.getElementById("lb-img"),
        lbCap = document.getElementById("lb-cap"), lbDl = document.getElementById("lb-dl");
    function esc(s) { return String(s).replace(/[&<>"']/g, function (c) { return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]; }); }
    function lbOpen(list, i) {
      PHOTOS = list; CUR = Math.max(0, Math.min(list.length - 1, i));
      var p = PHOTOS[CUR];
      lbImg.src = p.src; lbImg.alt = p.caption || "fellowship photo";
      lbCap.innerHTML = (p.caption ? "<b>" + esc(p.caption) + "</b>" : "Photo") + (p.credit ? " · " + esc(p.credit) : "");
      lbDl.href = p.src;
      document.getElementById("lb-i").textContent = CUR + 1;
      document.getElementById("lb-n").textContent = PHOTOS.length;
      lb.classList.add("open");
      document.body.style.overflow = "hidden";
    }
    function lbClose() { lb.classList.remove("open"); document.body.style.overflow = ""; lbImg.src = ""; }
    function lbStep(d) { lbOpen(PHOTOS, (CUR + d + PHOTOS.length) % PHOTOS.length); }
    document.getElementById("lb-x").addEventListener("click", lbClose);
    document.getElementById("lb-prev").addEventListener("click", function () { lbStep(-1); });
    document.getElementById("lb-next").addEventListener("click", function () { lbStep(1); });
    lb.addEventListener("click", function (e) { if (e.target === lb) lbClose(); });
    document.addEventListener("keydown", function (e) {
      if (!lb.classList.contains("open")) return;
      if (e.key === "Escape") lbClose();
      if (e.key === "ArrowLeft") lbStep(-1);
      if (e.key === "ArrowRight") lbStep(1);
    });
    // Every tile previews itself in the lightbox — the albums take over as photos land.
    document.querySelectorAll(".conv-tile").forEach(function (t) {
      var show = function () {
        lbOpen([{ src: t.querySelector("img").src, caption: t.getAttribute("data-cap") }], 0);
      };
      t.addEventListener("click", show);
      t.addEventListener("keydown", function (e) { if (e.key === "Enter" || e.key === " ") { e.preventDefault(); show(); } });
    });

    // ---- The albums: one fetch, real cards, lightbox when photos exist ----
    fetch("https://psychedelicsinrecovery.github.io/gallery/photos.json")
      .then(function (r) { if (!r.ok) throw new Error("no manifest"); return r.json(); })
      .then(function (data) {
        var grid = document.getElementById("album-grid");
        var albums = (data.albums || []).filter(function (a) { return !a.hidden; });
        if (!albums.length) { grid.innerHTML = '<p class="lede">The albums are still being gathered — check back soon.</p>'; return; }
        grid.innerHTML = albums.map(function (a) {
          var n = (a.photos || []).length;
          var links;
          if (n) {
            links = '<a class="s-primary" href="#" data-album="' + esc(a.id) + '"><i class="ph-fill ph-images"></i> Open the lightbox</a>';
          } else if (a.pixieset) {
            links = '<a class="s-primary" href="' + esc(a.pixieset) + '" target="_blank" rel="noopener"><i class="ph-fill ph-image"></i> See the album as it gathers</a>';
          } else {
            links = '<a class="s-primary" href="' + "https://psychedelicsinrecovery.github.io/gallery/walkthrough.html" + '"><i class="ph-fill ph-hand-heart"></i> Help it gather</a>';
          }
          if (a.astro) links += '<a class="s-ghost" href="' + esc(a.astro) + '"><i class="ph-fill ph-confetti"></i> Its Astro site</a>';
          return (
            '<button type="button" class="album-card" data-album="' + esc(a.id) + '">' +
            '<span class="a-icon"><i class="ph-fill ' + esc(a.icon || "ph-images") + '"></i></span>' +
            "<h3>" + esc(a.title) + "</h3>" +
            '<span class="a-meta">' + esc(a.when || "") + (a.place ? " · " + esc(a.place) : "") + "</span>" +
            '<span class="a-meta"><span class="a-count">' + (n ? n + " photo" + (n === 1 ? "" : "s") : "gathering now") + "</span></span>" +
            '<span class="a-links">' + links + "</span></button>"
          );
        }).join("");
        // Album cards with photos open the lightbox; cards without link onward.
        grid.querySelectorAll(".album-card").forEach(function (card) {
          var a = albums.filter(function (x) { return x.id === card.getAttribute("data-album"); })[0];
          var n = (a.photos || []).length;
          if (!n) return; // no photos yet: the links inside do the work
          var photos = (a.photos || []).map(function (p) { return { src: "https://psychedelicsinrecovery.github.io/gallery/" + (p.src || ""), caption: p.caption || "", credit: p.credit || "" }; });
          card.addEventListener("click", function (e) {
            if (e.target.closest("a")) return; // links behave as links
            lbOpen(photos, 0);
          });
        });
      })
      .catch(function () {
        document.getElementById("album-grid").innerHTML = '<p class="lede">The album list could not be loaded just now — the <a href="https://psychedelicsinrecovery.github.io/gallery/">full gallery</a> is a click away.</p>';
      });
  </script>
</Base>
